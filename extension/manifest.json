{
  "manifest_version": 3,
  "name": "Web Public Security Scanner",
  "version": "1.4.0",
  "description": "Professional read-only web security review: OWASP mapping, security headers, CORS, SRI, supply chain, secrets, PDF and account gating checks.",
  "action": {
    "default_title": "Public Security Scan",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
