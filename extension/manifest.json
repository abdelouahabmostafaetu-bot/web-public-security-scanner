{
  "manifest_version": 3,
  "name": "Web Public Security Scanner",
  "version": "1.3.0",
  "description": "Read-only vulnerability heuristics: PDF, VIP/account, secrets, XSS sinks, eval, admin paths, Firebase, sourcemaps, and more.",
  "action": {
    "default_title": "Public Security Scan",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
