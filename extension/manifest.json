{
  "manifest_version": 3,
  "name": "Web Public Security Scanner",
  "version": "1.2.0",
  "description": "Read-only step-by-step public page security scan: PDF, account/VIP, JWT, Firebase, secrets, links, libraries.",
  "action": {
    "default_title": "Public Security Scan",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
