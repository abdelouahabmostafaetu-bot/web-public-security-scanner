{
  "manifest_version": 3,
  "name": "Web Public Security Scanner",
  "version": "1.1.0",
  "description": "Step-by-step read-only public-page security scan: APIs, secrets, VIP/localStorage, PDF links, Firebase clues, paywall heuristics.",
  "action": {
    "default_title": "Public Security Scan",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
